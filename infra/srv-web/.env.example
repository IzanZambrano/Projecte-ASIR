# Copiar a .env y rellenar. El .env nunca se sube a Git.

# Conexión a srv-db (usuario de la aplicación, no el administrador)
POSTGRES_HOST=192.168.116.31
POSTGRES_PORT=5432
POSTGRES_DB=alpha_db
POSTGRES_USER=alpha_app
POSTGRES_PASSWORD=la_misma_que_APP_DB_PASSWORD_en_srv-db

# Opcional: sube el límite de PubMed de 3 a 10 peticiones/segundo
NCBI_API_KEY=

# Búsqueda diaria en PubMed (por defecto, a las 06:00 hora de Madrid)
INGESTA_ACTIVA=true
INGESTA_HORA=6
INGESTA_MINUTO=0
INGESTA_ZONA_HORARIA=Europe/Madrid
INGESTA_MAX_RESULTADOS=50

# Traducción automática de títulos y resúmenes (servicio "traductor" del compose).
# Déjalo vacío para no traducir.
TRADUCTOR_URL=http://traductor:5000
TRADUCTOR_IDIOMAS=es,ca
