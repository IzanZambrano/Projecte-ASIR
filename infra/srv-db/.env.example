# Copiar a .env y cambiar TODAS las contraseñas. El .env nunca se sube a Git.

# Administrador de PostgreSQL (solo para tareas de mantenimiento)
POSTGRES_DB=alpha_db
POSTGRES_USER=alpha_admin
POSTGRES_PASSWORD=cambia_esta_contraseña

# Usuario que usa la API (solo lectura/escritura de datos)
APP_DB_USER=alpha_app
APP_DB_PASSWORD=cambia_esta_otra_contraseña

# Copias de seguridad (scripts/backup.sh)
BACKUP_DIR=/var/backups/alpha
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=copias@192.168.56.12:/srv/backups/alpha
