# Copiar a .env y cambiar TODAS las contraseñas. El .env nunca se sube a Git.
# Generar contraseñas con:  openssl rand -base64 18

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=alpha_db

# Administrador (solo mantenimiento, copias y migraciones; la API no lo recibe)
POSTGRES_USER=alpha_admin
POSTGRES_PASSWORD=cambia_esta_contraseña

# Usuario de la aplicación (solo lee y escribe datos; no puede crear ni borrar tablas)
APP_DB_USER=alpha_app
APP_DB_PASSWORD=cambia_esta_otra_contraseña

# --- API: búsqueda diaria en PubMed ------------------------------------------
# Opcional: sube el límite de PubMed de 3 a 10 peticiones/segundo
NCBI_API_KEY=
INGESTA_ACTIVA=true
INGESTA_HORA=6
INGESTA_MINUTO=0
INGESTA_ZONA_HORARIA=Europe/Madrid
INGESTA_MAX_RESULTADOS=50

# --- Traducción automática (servicio "traductor") ----------------------------
# Déjalo vacío para no traducir.
TRADUCTOR_URL=http://traductor:5000
TRADUCTOR_IDIOMAS=es,ca

# --- Copias de seguridad (scripts/backup.sh) ---------------------------------
BACKUP_DIR=/var/backups/alpha
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=copias@192.168.116.32:/srv/backups/alpha
